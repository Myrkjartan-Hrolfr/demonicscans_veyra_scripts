.af-field input, .af-field select{
  padding:10px 12px; border-radius:10px;
  border:1px solid #2b2d44; background:#1e1e2e; color:#e6e9ff;
}
.af-actions{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
.af-status{ color:#cdd1ea; font-size:12px; min-height:16px; }
.af-badge{
  display:inline-block; padding:4px 10px; border-radius:999px;
  border:1px solid rgba(255,255,255,.10); background:rgba(255,255,255,.06);
  font-size:12px; font-weight:800; color:#e6e9ff;
}
.af-badge.on{ border-color:rgba(0,255,140,.25); background:rgba(0,255,140,.08); color:#7CFFB8; }
.af-badge.off{ border-color:rgba(255,211,105,.25); background:rgba(255,211,105,.08); color:#FFD369; }
.af-badge.fin{ border-color:rgba(255,0,96,.25); background:rgba(255,0,96,.08); color:#ff8aa2; }

.af-targets { width:100%; border-top:1px solid #232437; padding-top:12px; margin-top:8px; }
.af-row { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; padding:10px; border:1px solid #232437; border-radius:12px; background:#191a24; }
.af-row .btn{ margin-top:0; }
.af-row small{ color:#9aa0be; }
.afTStack ~ small + small{ display:none; }

.af-field input[type="range"]{
  padding:0;
  height:28px;
  border:none;
  background:transparent;
  accent-color:#FFD369;
}
.af-field input[type="range"][disabled]{ opacity:.5; cursor:not-allowed; }

/* --- Auto Farm collapse (cookie) --- */
#autoFarmPanel.af-collapsed #autoFarmBody { display:none; }

#afToggleBtn{
  background:#333;
  border:none;
  border-radius:8px;
  padding:8px 12px;
  font-size:13px;
  color:#fff;
  cursor:pointer;
  border:1px solid #2b2d44;
  box-shadow:0 6px 18px rgba(0,0,0,.6);
}
#afToggleBtn:hover{ background:#444; }

/* --- Mini progress bars (visible even when collapsed) --- */
.af-mini-bars{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:stretch;
}
.af-mini-item{
  flex:1 1 200px;
  min-width:200px;
  background:#191a24;
  border:1px solid #232437;
  border-radius:12px;
  padding:10px 12px;
  box-shadow:0 10px 26px rgba(0,0,0,.55);
}
.af-mini-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
  margin-bottom:8px;
  color:#cdd1ea;
  font-size:12px;
  font-weight:800;
}
.af-mini-top span:last-child{
  color:#FFD369;
  font-variant-numeric: tabular-nums;
  font-weight:900;
}
.af-mini-track{
  height:10px;
  border-radius:999px;
  overflow:hidden;
  background:linear-gradient(180deg,#22263a,#171929);
  border:1px solid #2b2d44;
  box-shadow:inset 0 2px 6px rgba(0,0,0,.6);
}
.af-mini-fill{
  height:100%;
  width:0%;
  border-radius:999px;
  background:linear-gradient(90deg, rgba(255,211,105,.20), rgba(255,211,105,.95));
  transition:width .35s ease;
}

