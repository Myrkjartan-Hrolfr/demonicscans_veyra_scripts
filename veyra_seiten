function baseQS(monsterId){
  const p = new URLSearchParams();
  p.set('id', String(monsterId || 0));          // ✅ important
  p.set('monster_id', String(monsterId || 0));  // (optional fallback)
  return p.toString();
}


  function withQS(url, qs){
    if (!url) return '';
    return url + (url.includes('?') ? '&' : '?') + qs;
  }

  function parseJsonLoose(txt) {
    const text = String(txt ?? '');
    const trimmed = text.replace(/^\uFEFF/, '').trim();
    const candidates = [text, trimmed];
    const firstBrace = trimmed.indexOf('{');
    const lastBrace = trimmed.lastIndexOf('}');
    if (firstBrace >= 0 && lastBrace > firstBrace) {
      candidates.push(trimmed.slice(firstBrace, lastBrace + 1));
    }

    for (const candidate of candidates) {
      if (!candidate) continue;
      try { return JSON.parse(candidate); } catch (_e) {}
    }
    return null;
  }

  function waitMs(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  async function postForm(url, payload, retryInvalidRequest = false, attempt = 1){
    const fd = new URLSearchParams();
    Object.entries(payload || {}).forEach(([k,v]) => fd.append(k, v));

    const res = await fetch(url, {
      method:'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: fd.toString(),
      credentials:'same-origin'
    });
    const txt = await res.text();
    const data = parseJsonLoose(txt);

    if (retryInvalidRequest && attempt < 2 && data && data.message === 'Invalid request.') {
      await waitMs(350);
      return postForm(url, payload, retryInvalidRequest, attempt + 1);
    }

    return { ok: res.ok, data, raw: txt };
  }

  async function getReq(url){
    const res = await fetch(url, { method:'GET', credentials:'same-origin' });
    const txt = await res.text();
    try { return { ok: res.ok, data: JSON.parse(txt), raw: txt }; }
    catch(_e){ return { ok: res.ok, data: null, raw: txt }; }
  }

function normalizeOk(r){
  const raw = String(r?.raw || '');
  const d = r?.data || {};

  const ok =
    d.status === 'success' ||
    d.ok === true ||
    d.success === true ||
    /^\s*success\s*$/i.test(raw) ||
    /joined|already joined/i.test(raw);

  const msg =
    (typeof d.message === 'string' && d.message.trim()) ? d.message :
    (typeof d.error === 'string' && d.error.trim()) ? d.error :
    raw || (ok ? 'OK' : 'Failed');

  return { ok, msg, data: d, raw };
}







  const statusEl = document.getElementById('batchAttackStatus');

function showStatus(t){
  if (!statusEl) return;
  statusEl.innerHTML = t || '';
}


   // ---------- FILTERS (cookie-persisted + select dropdown) ----------
  const nameSel   = document.getElementById('fNameSel');
  const fJoined   = document.getElementById('fJoined');
  const fUnjoined = document.getElementById('fUnjoined');
  const fCapNotReached = document.getElementById('fCapNotReached');

  // Make filter cookie unique per wave/mode so it doesn’t bleed to other waves
  const WAVE_FILTER_KEY = (() => {
    const qs = new URLSearchParams(location.search);
    const gate  = qs.get('gate')  || '0';
    const event = qs.get('event') || '0';
    const wave  = qs.get('wave')  || '0';
    const mode  = (parseInt(event,10) > 0) ? 'E' + event : 'G' + gate;
    return `wave_filters_${mode}_W${wave}`;
  })();

  function saveWaveFilters(){
    const payload = {
      name: (nameSel?.value || ''),                 // lowercase key stored
      joined: !!fJoined?.checked,
      unjoined: !!fUnjoined?.checked,
      cap: !!fCapNotReached?.checked
    };
    setCookie(WAVE_FILTER_KEY, JSON.stringify(payload), 30);
  }

  function loadWaveFilters(){
    const raw = getCookie(WAVE_FILTER_KEY);
    if (!raw) return null;
    try { return JSON.parse(raw); } catch(_e){ return null; }
  }

  function buildMonsterNameOptions(){
    if (!nameSel) return;

    // Collect unique names from ALIVE monster cards (QOL ignores dead anyway)
    const seen = new Map(); // lower -> display
    document.querySelectorAll('.monster-card[data-dead="0"]').forEach(card => {
      const lower = (card.dataset.name || '').trim(); // you already store lowercase in data-name
      if (!lower) return;
      // Use the visible title as display text (keeps case/spaces)
      const h3 = card.querySelector('h3');
      const display = (h3 && h3.textContent) ? h3.textContent.trim() : lower;
      if (!seen.has(lower)) seen.set(lower, display);
    });

    // Preserve current selection
    const current = nameSel.value || '';

    // Reset options (keep "All monsters")
    nameSel.innerHTML = `<option value="">All monsters</option>`;

    // Sort by display text
    const arr = Array.from(seen.entries()).sort((a,b) => a[1].localeCompare(b[1]));
    for (const [lower, display] of arr){
      const opt = document.createElement('option');
      opt.value = lower;          // match card.dataset.name (lowercase)
      opt.textContent = display;  // pretty label
      nameSel.appendChild(opt);
