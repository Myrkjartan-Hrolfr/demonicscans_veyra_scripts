<style>
    :root {
        --bg-top: #0f1115;
        --bg-bottom: #020308;
        --line: #2a303b;
        --text: #f4f4f4;
        --muted: #9ca3af;
        --accent: #e1b65b;
        --accent-strong: #f4d389;
        --sky: #7dd3fc;
        --danger: #b91c1c;
        --success: #16a34a;
        --shadow: 0 18px 40px rgba(0, 0, 0, 0.7);
    }
    * { box-sizing: border-box; }
    body {
        margin: 0;
        min-height: 100vh;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--text);
        background: radial-gradient(circle at top, #202436 0, #05060a 55%, #020308 100%);
    }
    .page-wrap { min-height: 100vh; padding: 18px 14px 42px; }
    .page-inner { max-width: 1200px; margin: 0 auto; padding: 16px 16px 40px; }
    .back-row { display: flex; justify-content: flex-start; margin-bottom: 14px; }
    .back-btn,
    .section-btn,
    .action-btn,
    .danger-btn,
    .reward-trigger {
        appearance: none;
        border: 1px solid rgba(148, 163, 184, 0.36);
        border-radius: 999px;
        cursor: pointer;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform 0.12s ease-out, box-shadow 0.12s ease-out;
    }
    .back-btn:hover,
    .section-btn:hover,
    .action-btn:hover,
    .danger-btn:hover,
    .reward-trigger:hover { transform: translateY(-1px); box-shadow: 0 12px 28px rgba(2, 6, 23, 0.34); }
    .back-btn, .section-btn {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.98), rgba(7, 14, 22, 0.98));
        color: var(--text);
    }
    .action-btn, .reward-trigger {
        background: linear-gradient(135deg, #0ea5e9, #38bdf8);
        color: #082032;
        border-color: rgba(125, 211, 252, 0.65);
    }
    .danger-btn {
        background: linear-gradient(135deg, rgba(248, 113, 113, 0.24), rgba(239, 68, 68, 0.18));
        color: #fee2e2;
        border-color: rgba(248, 113, 113, 0.42);
    }
    .panel {
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        overflow: hidden;
    }
    .panel--banner {
        margin-bottom: 16px;
        padding: 0;
        overflow: hidden;
        height: clamp(180px, 18vw, 260px);
    }
    .banner-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #232437;
    }
    .banner {
        position: relative;
        margin-bottom: 22px;
        padding: 26px 24px;
        border-radius: 18px;
        background:
            radial-gradient(circle at 0 0, rgba(248, 250, 252, 0.12), transparent 60%),
            radial-gradient(circle at 100% 0, rgba(254, 215, 170, 0.25), transparent 55%),
            linear-gradient(135deg, #020617 0%, #111827 50%, #020617 100%);
        border: 1px solid rgba(148, 163, 184, 0.35);
        box-shadow: var(--shadow);
        overflow: hidden;
    }
    .banner::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background:
            linear-gradient(120deg, rgba(15, 23, 42, 0.12), rgba(15, 23, 42, 0.58));
        pointer-events: none;
    }
    .banner-content {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 18px;
        align-items: start;
    }
    .banner-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        font-size: 11px;
