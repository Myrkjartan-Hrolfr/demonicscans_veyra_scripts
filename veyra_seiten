.full-width, .hero, .banner, .container-100vw { width: 100% !important; max-width: 100% !important; }
[class*="container"] { max-width: 100%; }

/* If any section must truly bleed edge-to-edge, give it this class intentionally */
.full-bleed{
  margin-inline: calc(50% - 50vw);
  padding-inline: calc(50vw - 50%);
}

