<script>
  function lootDisplayQty(item) {
    return Math.max(1, Number(item?.QUANTITY ?? item?.quantity ?? 1));
  }

  function openBatchLootModal(summary, items, notes) {
  const sumEl = document.getElementById('blmSummary');
  const totalItemQty = (items || []).reduce((sum, item) => sum + lootDisplayQty(item), 0);
  sumEl.innerHTML = `
    <span class="chip">Processed: ${summary.processed}</span>
    <span class="chip">Success: ${summary.success}</span>
    <span class="chip">Fail: ${summary.fail}</span>
    <span class="chip">EXP: ${new Intl.NumberFormat().format(summary.exp)}</span>
    <span class="chip">Gold: ${new Intl.NumberFormat().format(summary.gold)}</span>
    <span class="chip">Items: ${new Intl.NumberFormat().format(totalItemQty)}</span>
  `;

  const noteEl = document.getElementById('blmNote');
  const DROPLESS_PATTERNS = [
    /^\s*no item dropped/i,
    /^\s*you didn[’']?t reach the damage requirement/i
  ];
  let filteredNotes = (notes || []).filter(Boolean);
  if (items.length > 0) {
    filteredNotes = filteredNotes.filter(n => !DROPLESS_PATTERNS.some(p => p.test(n)));
  }
  const noteText = Array.from(new Set(filteredNotes)).join(' ');
  if (noteText) { noteEl.style.display = 'block'; noteEl.textContent = noteText; }
  else { noteEl.style.display = 'none'; noteEl.textContent = ''; }

  const grid = document.getElementById('batchLootItems');
  grid.innerHTML = items.length
    ? items.map(it => {
      const qty = lootDisplayQty(it);
      const qtyText = new Intl.NumberFormat().format(qty);
      return `
        <div class="blm-item">
          <span style="position:relative;display:inline-block;">
            <img src="${it.IMAGE_URL}" alt="${it.NAME}">
            ${qty > 1 ? `<b style="position:absolute;right:-7px;bottom:-5px;background:#ffd369;color:#1b1300;border:1px solid rgba(255,255,255,.55);border-radius:999px;padding:2px 6px;font-size:11px;box-shadow:0 3px 10px rgba(0,0,0,.45);">x${qtyText}</b>` : ``}
          </span>
          <small>${qty > 1 ? `x${qtyText} ` : ``}${it.NAME}</small>
          ${it.TIER ? `<small class="muted">${it.TIER}</small>` : ``}
        </div>
      `;
    }).join('')
    : `<div class="muted" style="padding:6px 0;">No items this time.</div>`;

  document.getElementById('batchLootModal').style.display = 'flex';
}

  const LOOT_URL = 'loot.php';

  const $btn   = document.getElementById('btnLootX');
  const $input = document.getElementById('lootCount');
  const $stat  = document.getElementById('lootStatus');

  async function lootOne(monsterId) {
    const fd = new FormData();
    fd.append('monster_id', monsterId);
    const res = await fetch(LOOT_URL, { method: 'POST', body: fd, credentials: 'same-origin' });
    const data = await res.json().catch(() => ({}));
    const ok = (data && data.status === 'success');
    const base = { ok, msg: (ok ? (data.message || 'OK') : ((data && data.message) ? data.message : 'Failed')) };
    return Object.assign(base, {
      items: ok && Array.isArray(data.items) ? data.items : [],
      exp: ok ? (data.rewards?.exp || 0) : 0,
      gold: ok ? (data.rewards?.gold || 0) : 0,
      note: ok ? (data.note || '') : base.msg
    });
  }

  function setRunning(running) {
    if (running) { $btn.classList.add('is-running'); $btn.textContent = 'Working...'; }
    else { $btn.classList.remove('is-running'); $btn.textContent = '💰 Loot X monsters'; }
  }

  $btn?.addEventListener('click', async () => {
    const n = Math.max(1, parseInt($input.value || '1', 10));
    const eligibleEls = Array.from(document.querySelectorAll('.monster-card[data-eligible="1"]'));
    const targetIds = eligibleEls.slice(0, n).map(el => parseInt(el.dataset.monsterId, 10)).filter(Boolean);

    if (targetIds.length === 0) { $stat.textContent = 'No eligible dead monsters you joined.'; return; }

    setRunning(true);
    let ok = 0, fail = 0;
    let totalExp = 0, totalGold = 0;
    const allItems = [];
    const allNotes = [];
    for (let i = 0; i < targetIds.length; i++) {
      $stat.textContent = `Looting ${i+1}/${targetIds.length}... (success: ${ok}, fail: ${fail})`;
      try {
        const res = await lootOne(targetIds[i]);
        if (res.ok) {
          ok++;
          totalExp += res.exp;
          totalGold += res.gold;
          if (res.items?.length) { allItems.push(...res.items); }
          else if (res.note) { allNotes.push(res.note); }
          const el = document.querySelector(`.monster-card[data-monster-id="${targetIds[i]}"]`);
          if (el) el.setAttribute('data-eligible','0');
        } else { fail++; if (res.note) allNotes.push(res.note); }
      } catch (_e) { fail++; allNotes.push('Server error'); }
      await new Promise(r => setTimeout(r, 200));
    }
    $stat.textContent = `Done. Looted ${ok}, failed ${fail}.`;
    setRunning(false);
    openBatchLootModal(
      { processed: targetIds.length, success: ok, fail, exp: totalExp, gold: totalGold },
      allItems,
      allNotes
    );
  });
</script>
<script>
  function setCookie(name, value, days) {
    const maxAge = days * 24 * 60 * 60;
    document.cookie = `${name}=${encodeURIComponent(value)}; Max-Age=${maxAge}; Path=/; SameSite=Lax`;
  }
  function getCookie(name) {
    const m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return m ? decodeURIComponent(m.pop()) : null;
  }
  function setToggleLabel(btn, hideDead) {
    btn.textContent = hideDead ? '👁️ Show unclaimed kills' : '🙈 Show Alive monsters';
  }
  function setDeadBossToggleLabel(btn, bossesOnly) {
    btn.textContent = bossesOnly ? 'Show all dead kills' : 'Dead bosses only';
    btn.classList.toggle('active', !!bossesOnly);
  }
  function applyDeadFilter(hideDead) {
    const cards = document.querySelectorAll('.monster-card');
    cards.forEach(card => {
      const isDead = card.getAttribute('data-dead') === '1';
      card.style.display = (hideDead && isDead) ? 'none' : '';
    });
  }
  function reloadWithDeadPage(pageNumber) {
    const url = new URL(window.location.href);
    if (pageNumber && pageNumber > 1) {
      url.searchParams.set('dead_page', String(pageNumber));
    } else {
      url.searchParams.delete('dead_page');
    }
    window.location.href = url.toString();
  }
  (function () {
    const btn = document.getElementById('toggleDeadBtn');
    const bossBtn = document.getElementById('toggleDeadBossBtn');
    if (!btn) return;
    const stored = getCookie('hide_dead_monsters');
    const bossStored = getCookie('show_dead_bosses_only');
    // 🔥 If cookie doesn't exist, create it with default 0
  if (stored === null || stored === undefined || bossStored === null || bossStored === undefined) {
    if (stored === null || stored === undefined) {
      setCookie('hide_dead_monsters', '0', 300);
    }
    if (bossStored === null || bossStored === undefined) {
      setCookie('show_dead_bosses_only', '0', 300);
    }
        window.location.reload();
    return; // stop execution so nothing else runs

  }

    let hideDead = stored === '1';
    let deadBossesOnly = bossStored === '1';
    setToggleLabel(btn, hideDead);
    if (bossBtn) setDeadBossToggleLabel(bossBtn, deadBossesOnly);
    applyDeadFilter(hideDead);
    btn.addEventListener('click', () => {
  hideDead = !hideDead;
  setCookie('hide_dead_monsters', hideDead ? '1' : '0', 30);
  reloadWithDeadPage(1);
});
    bossBtn?.addEventListener('click', () => {
  deadBossesOnly = !deadBossesOnly;
  setCookie('show_dead_bosses_only', deadBossesOnly ? '1' : '0', 30);
  setCookie('hide_dead_monsters', '0', 30);
  reloadWithDeadPage(1);
});

  })();
</script>
<script>
(function(){
  // update all countdown timers once per second
  function fmtTimeLeft(secLeft) {
    if (secLeft <= 0) return "0s";
    const s = Math.floor(secLeft % 60);
    const totalMin = Math.floor(secLeft / 60);
    const m = totalMin % 60;
    const h = Math.floor(totalMin / 60);
    // show "Hh Mm Ss" if >1h, else "Mm Ss"
    if (h > 0) {
      return h + "h " + m + "m " + s + "s";
    } else {
      return m + "m " + s + "s";
    }
  }

  function tickTimers() {
    const nowSec = Date.now() / 1000;
    document.querySelectorAll('.monster-card[data-dead="1"]').forEach(card => {
      const expire = parseInt(card.getAttribute('data-expire'), 10) || 0;
      if (!expire) return; // no timestamp, nothing to show

      const span = card.querySelector('.death-timer .timer-text');
      if (!span) return;

      const left = Math.max(0, Math.floor(expire - nowSec));
      span.textContent = fmtTimeLeft(left);
    });
  }

  tickTimers();            // initial paint
  setInterval(tickTimers, 1000); // update every second
})();
function deleteCookie(name){
  document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax`;
