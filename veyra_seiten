(function () {
  const box = document.getElementById('guildChatPreview');
  if (!box) return;

  const scrollToBottom = () => { box.scrollTop = box.scrollHeight; };

  // Scroll after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => setTimeout(scrollToBottom, 0));
  } else {
    setTimeout(scrollToBottom, 0);
  }

  // If images in messages load later, keep it pinned to bottom
  box.querySelectorAll('img').forEach(img => {
    img.addEventListener('load', scrollToBottom);
  });
})();
</script>
<script>
(function(){
  const form = document.getElementById('guildProfileForm');
  if(!form) return;

  const msg = document.getElementById('guildProfileMsg');
  const btn = document.getElementById('guildProfileSaveBtn');

  function showMsg(text, ok){
    msg.style.display = 'block';
    msg.textContent = text;
    msg.style.color = ok ? '#63e680' : '#ff6b6b';
  }

  let busy = false;

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if (busy) return;
    busy = true;

    btn.disabled = true;
    btn.style.opacity = '0.7';
    btn.textContent = 'Saving...';

    msg.style.display = 'none';
    msg.textContent = '';

    try {
      const fd = new FormData(form);

      const res = await fetch('guild_profile_update.php', {
        method: 'POST',
        body: fd,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });

      const data = await res.json().catch(()=>null);
      if(!data) throw new Error('Bad server response.');

      if(data.status === 'ok'){
        showMsg(data.message || 'Saved.', true);

        // Optional: update the guild name in the header on the page without reload
        // (only if you add an id="guildNameText" where the name is displayed)
        // document.getElementById('guildNameText').textContent = data.guild_name;

      } else {
        showMsg(data.message || 'Error.', false);
      }

    } catch (err){
      showMsg('Server error. Please try again.', false);
    } finally {
      busy = false;
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.textContent = 'Save Changes';
    }
  });
})();
</script>



