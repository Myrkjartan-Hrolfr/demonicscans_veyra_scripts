<html lang="en"><head>
    <meta charset="UTF-8">
    <title>Olympus - Wave 1</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        /* 1) Make padding logical and robust */
html, body { margin: 0; }
*, *::before, *::after { box-sizing: border-box; }



/* 2) Kill common causes: 100vw and full-bleed overlays */
.full-width, .hero, .banner, .container-100vw { width: 100% !important; max-width: 100% !important; }
[class*="container"] { max-width: 100%; }

/* If any section must truly bleed edge-to-edge, give it this class intentionally */
.full-bleed{
  margin-inline: calc(50% - 50vw);
  padding-inline: calc(50vw - 50%);
}

/* 3) Fixed overlays should respect padding */
.page-overlay{ position: fixed; inset: 0; pointer-events: none; }

        body { background:#121212; font-family:'Segoe UI', sans-serif; color:#fff; margin:0; padding-block: 10px;padding-inline: 10px;}
        h1 { text-align:center; margin-bottom:10px; font-size:28px; color:#f39c12; }
        .wave-title { text-align:center; font-size:22px; color:#e0e0e0; margin:0 auto 18px; max-width:900px;}
        .monster-container {
            display:grid;
            grid-template-columns:repeat(auto-fit, minmax(250px, 250px));
            justify-content:center;
            align-items:start;
            gap:16px;
            width:min(100%, 1328px);
            margin:0 auto;
        }
        .monster-section-title {
            grid-column: 1 / -1;
            width:100%;
            max-width:none;
            margin: 4px 0 0;
            padding: 12px 16px;
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(36,39,62,.96), rgba(21,23,37,.96));
            border: 1px solid rgba(255,255,255,.08);
            color: #f1f3ff;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: .02em;
            text-align: left;
            box-shadow: 0 10px 24px rgba(0,0,0,.32);
        }
        .monster-section-title small {
            color: #b8bfdf;
            font-size: 13px;
            font-weight: 600;
            margin-left: 8px;
        }
        .monster-section-title.boss {
            background: linear-gradient(180deg, rgba(74,30,24,.96), rgba(33,16,17,.96));
            border-color: rgba(255,176,117,.22);
            color: #ffe2b2;
        }
        .monster-card {
            background:#1e1e2e;
            border-radius:12px;
            width:250px;
            max-width:100%;
            padding:16px;
            text-align:center;
            transition:transform .3s ease;
            justify-self:center;
        }
        .monster-card:hover { transform:scale(1.02); }
        .monster-img { max-width:100%; height:auto; border-radius:8px; }
        .grayscale { filter:grayscale(100%); }
        .hp-bar { background:#333; height:16px; border-radius:10px; overflow:hidden; margin:8px 0; }
        .hp-fill { height:100%; background:linear-gradient(to right,#55ff55,#00cc00); }
        .join-btn { background:#3498db; border:none; color:#fff; padding:10px 14px; border-radius:6px; margin-top:8px; cursor:pointer; font-size:14px; }
        .join-btn:hover { background:#2980b9; }
        .continue-btn { background:#3498db; border:none; color:#fff; padding:10px 14px; border-radius:6px; margin-top:8px; cursor:pointer; font-size:14px; }
        .continue-btn:hover { background:#2980b9; }
        @media (max-width:600px){
            .monster-container { grid-template-columns:minmax(0, 1fr); }
            .monster-card { width:min(100%, 420px); }
        }
        .btn { margin-top:8px; padding:6px 10px; background:#333; color:#fff; border:none; border-radius:5px; font-size:13px; cursor:pointer; }
        .btn:hover { background:#555; }
        .memory-empty-modal {
            position: fixed;
            z-index: 10050;
            inset: 0;
            display: grid;
            padding: 20px;
            place-items: center;
            background: rgba(2, 5, 11, .84);
            backdrop-filter: blur(7px);
        }
        .memory-empty-modal[hidden] { display: none; }
        .memory-empty-card {
            width: min(540px, 100%);
            padding: 28px;
