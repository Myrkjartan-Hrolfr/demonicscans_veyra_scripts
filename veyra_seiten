<html lang="en" style="--topbarH: 0px;"><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Olympus Domains</title>
  <style>
    :root{
      --topbarH:0px;
      --sky:#07111e;
      --deep:#05070d;
      --panel:rgba(8,12,22,.86);
      --panel2:rgba(13,20,34,.92);
      --gold:#d9b45f;
      --gold2:#ffe2a0;
      --silver:#dbe7f4;
      --aether:#66d9ff;
      --locked:#6f7686;
      --stroke:rgba(255,255,255,.13);
    }
    *{box-sizing:border-box}
    html,
    body,
    .olympus-shell,
    .map-frame,
    .map-stage,
    .map-img{
      overscroll-behavior:none;
      touch-action:none;
    }
    body{
      margin:0;
      min-height:100vh;
      overflow:hidden;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      color:#eef5ff;
      background:
        radial-gradient(900px 520px at 18% 8%, rgba(102,217,255,.14), transparent 64%),
        radial-gradient(760px 520px at 88% 78%, rgba(217,180,95,.15), transparent 62%),
        linear-gradient(180deg, var(--sky), var(--deep));
    }
    a{color:inherit}
    .olympus-shell{
      position:fixed;
      left:0;
      right:0;
      top:var(--topbarH);
      height:calc(100dvh - var(--topbarH));
      width:100%;
      margin:0;
      padding:0;
      z-index:50;
      overflow:hidden;
      background:
        radial-gradient(900px 520px at 18% 8%, rgba(102,217,255,.12), transparent 64%),
        linear-gradient(180deg, #05070d, #02040a);
    }
    .map-back-btn{
      position:absolute;
      left:10px;
      top:10px;
      z-index:30;
      display:flex;
      align-items:center;
      justify-content:flex-start;
      min-height:42px;
      padding:10px 14px;
      border:1px solid rgba(217,180,95,.28);
      border-radius:13px;
      background:rgba(8,12,22,.78);
      text-decoration:none;
      font-weight:800;
      white-space:nowrap;
      box-shadow:0 12px 30px rgba(0,0,0,.42);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
      touch-action:manipulation;
    }
    .eyebrow{
      display:inline-flex;
      padding:6px 10px;
      border-radius:999px;
      border:1px solid rgba(217,180,95,.3);
      color:var(--gold2);
      background:rgba(217,180,95,.08);
      font-size:11px;
      font-weight:900;
      letter-spacing:.12em;
      text-transform:uppercase;
    }
    h1{margin:6px 0 0;font-size:clamp(22px,3vw,34px);line-height:1;color:#fff}
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:42px;
      padding:10px 14px;
      border:1px solid rgba(217,180,95,.28);
      border-radius:13px;
      background:rgba(8,12,22,.78);
      color:#f4d483;
      text-decoration:none;
      font-weight:800;
      white-space:nowrap;
      box-shadow:0 12px 30px rgba(0,0,0,.42);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }
    .btn.primary{
      color:#111722;
      background:linear-gradient(180deg, var(--gold2), var(--gold));
      border-color:rgba(217,180,95,.55);
      box-shadow:0 10px 28px rgba(217,180,95,.18);
    }
    .btn:hover,
    .btn:focus-visible{
      color:#ffe6a8;
      border-color:rgba(217,180,95,.5);
      background:rgba(15,25,44,.94);
    }
    .btn.primary:hover,
    .btn.primary:focus-visible{
      color:#0b111f;
      background:linear-gradient(180deg, #ffe6a8, var(--gold));
    }
    .map-frame{
      position:absolute;
      inset:0;
      overflow:hidden;
      border:0;
      border-radius:0;
      background:#05070d;
      box-shadow:0 28px 80px rgba(0,0,0,.45);
      touch-action:none;
    }
    .map-stage{
      position:absolute;
      left:0;
      top:0;
      width:var(--mw, 2000px);
      height:var(--mh, 1200px);
      line-height:0;
      transform-origin:0 0;
      will-change:transform;
      user-select:none;
    }
    .map-stage::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(circle at 52% 18%, rgba(255,226,160,.16), transparent 18%),
        linear-gradient(180deg, rgba(5,7,13,.08), rgba(5,7,13,.36));
    }
    .map-img{
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
      pointer-events:none;
      user-select:none;
      -webkit-user-drag:none;
      background:
        radial-gradient(circle at 50% 35%, rgba(102,217,255,.12), transparent 38%),
        linear-gradient(135deg, #0c1728, #05070d);
    }
    .domain-marker{
      position:absolute;
      left:50%;
      top:50%;
      z-index:4;
      width:176px;
      height:176px;
      border-radius:999px;
      border:2px solid rgba(255,255,255,.42);
      transform:translate(-50%,-76%);
      display:grid;
      place-items:center;
      text-decoration:none;
      color:#101520;
      font-size:60px;
      font-weight:1000;
      cursor:pointer;
      background:
        radial-gradient(circle at 30% 24%, rgba(255,255,255,.85), transparent 28%),
        linear-gradient(145deg, var(--gold2), var(--gold));
      box-shadow:
        0 18px 38px rgba(0,0,0,.55),
        0 0 0 10px rgba(217,180,95,.16),
        0 0 42px rgba(217,180,95,.28);
      transition:transform .14s ease, filter .14s ease, box-shadow .14s ease;
    }
    .domain-marker::before{
      content:"";
      position:absolute;
      inset:-30px;
      border-radius:999px;
      border:2px solid rgba(255,226,160,.34);
      animation:pulse 2.15s ease-out infinite;
      pointer-events:none;
    }
    .domain-marker::after{
      content:"";
      position:absolute;
      left:50%;
      bottom:-24px;
      width:48px;
      height:48px;
      transform:translateX(-50%) rotate(45deg);
      border-radius:6px;
      background:linear-gradient(145deg, var(--gold2), var(--gold));
      z-index:-1;
      box-shadow:0 12px 22px rgba(0,0,0,.35);
    }
    .domain-marker:hover{
      transform:translate(-50%,-92%) scale(1.07);
      filter:brightness(1.06) saturate(1.08);
      box-shadow:
        0 22px 46px rgba(0,0,0,.6),
        0 0 0 12px rgba(217,180,95,.2),
        0 0 56px rgba(217,180,95,.38);
    }
    .domain-marker.locked{
      color:#eef2fa;
      background:
        radial-gradient(circle at 30% 24%, rgba(255,255,255,.45), transparent 30%),
        linear-gradient(145deg, #8d95a3, #4f5664);
      box-shadow:0 18px 38px rgba(0,0,0,.55), 0 0 0 10px rgba(111,118,134,.14);
    }
    .domain-marker.locked::before{border-color:rgba(180,190,210,.2);animation:none}
    .domain-marker.locked::after{background:linear-gradient(145deg, #8d95a3, #4f5664)}
    .domain-marker-img{
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
      border-radius:999px;
      pointer-events:none;
    }
    .domain-marker.locked .domain-marker-img{
      filter:grayscale(.45) brightness(.88);
    }
    .marker-label{
      position:absolute;
      left:50%;
      top:calc(100% + 18px);
      transform:translateX(-50%);
      padding:6px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.14);
      background:rgba(5,7,13,.74);
      color:#fff;
      font-size:12px;
      line-height:1;
      white-space:nowrap;
      box-shadow:0 10px 22px rgba(0,0,0,.35);
      pointer-events:none;
    }
    .domain-countdown{
      display:block;
      margin-top:5px;
      color:var(--gold2);
      font-size:11px;
      font-weight:1000;
      letter-spacing:.04em;
      text-shadow:0 0 12px rgba(217,180,95,.36), 0 1px 2px rgba(0,0,0,.75);
      text-transform:none;
    }
    .npc-marker{
      position:absolute;
      left:50%;
      top:50%;
      z-index:5;
      width:140px;
      height:140px;
      border:2px solid rgba(160,220,255,.44);
      border-radius:44px;
      transform:translate(-50%,-74%);
      display:grid;
      place-items:center;
      color:#eef8ff;
      cursor:pointer;
      font-weight:1000;
      font-size:40px;
      letter-spacing:.04em;
      background:
        radial-gradient(circle at 32% 20%, rgba(255,255,255,.38), transparent 30%),
        linear-gradient(145deg, rgba(33,72,115,.96), rgba(12,19,35,.96));
      box-shadow:
        0 18px 34px rgba(0,0,0,.52),
        0 0 0 8px rgba(102,217,255,.10),
        0 0 34px rgba(102,217,255,.18);
      transition:transform .14s ease, filter .14s ease;
    }
    .npc-marker:hover{
      transform:translate(-50%,-88%) scale(1.06);
      filter:brightness(1.12);
    }
    .npc-marker::after{
      content:"";
      position:absolute;
      left:50%;
      bottom:-11px;
      width:34px;
      height:34px;
      transform:translateX(-50%) rotate(45deg);
      border-radius:5px;
      background:linear-gradient(145deg, rgba(33,72,115,.96), rgba(12,19,35,.96));
      z-index:-1;
    }
    .npc-marker-img{
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
      border-radius:42px;
      pointer-events:none;
    }
    .npc-marker .marker-label{
      border-color:rgba(102,217,255,.22);
      background:rgba(4,12,24,.8);
    }
    .npc-role{
      display:block;
      margin-top:5px;
      color:rgba(238,245,255,.62);
      font-size:11px;
      line-height:1.3;
    }
    .modal-backdrop{
      position:fixed;
      inset:0;
      z-index:1000;
      display:none;
      place-items:center;
      padding:20px;
      background:rgba(0,0,0,.72);
      overflow-y:auto;
      -webkit-overflow-scrolling:touch;
    }
    .modal-backdrop.open{display:grid}
    .modal{
