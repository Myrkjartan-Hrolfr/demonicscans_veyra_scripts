    notif.id = "notification";

    const contentArea = document.querySelector('.content-area');
    if (contentArea) {
      const lootModalElement = modal.firstElementChild;
      contentArea.appendChild(lootModalElement);
      contentArea.appendChild(notif);

      lootModalElement.addEventListener('click', function (event) {
        this.style.display = 'none';
      });
    }
  }

  document.querySelectorAll('.monster-card > a').forEach(x => {
    if (x.innerText.includes('Loot')) {
      x.innerText = 'View';
      x.style.textDecoration = 'none';
      x.className = 'join-btn';

      var instaBtn = document.createElement('button');
      const monsterId = x.href.split("id=")[1];
      instaBtn.onclick = function () {
        lootWave(monsterId);
      };
      instaBtn.className = "join-btn";
      instaBtn.innerText = "Loot Instantly";
      instaBtn.style.marginRight = '8px';
      instaBtn.setAttribute('data-monster-id', monsterId);
      x.before(instaBtn);
    }
  });
