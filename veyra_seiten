            --text-main: #f4f4f4;
            --text-muted: #9ca3af;
            --danger: #b91c1c;
            --success: #16a34a;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: radial-gradient(circle at top, #202436 0, #05060a 55%, #020308 100%);
            color: var(--text-main);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .page-wrap {
            min-height: 100vh;
        }

        .page-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px 16px 40px;
        }

        /* Back button */
        .back-row {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(148, 163, 184, 0.35);
            font-size: 13px;
            color: var(--text-muted);
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s, transform 0.1s;
        }

        .back-btn:hover {
            background: rgba(15, 23, 42, 1);
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-1px);
        }

        .back-btn span.icon {
            font-size: 18px;
            line-height: 1;
        }

        /* Banner */
        .banner {
            position: relative;
            border-radius: 18px;
            padding: 26px 24px;
            margin-bottom: 22px;
            overflow: hidden;
            background:
                radial-gradient(circle at 0 0, rgba(248, 250, 252, 0.12), transparent 60%),
                radial-gradient(circle at 100% 0, rgba(254, 215, 170, 0.25), transparent 55%),
                linear-gradient(135deg, #020617 0%, #111827 50%, #020617 100%);
            border: 1px solid rgba(148, 163, 184, 0.35);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7);
        }

        .banner::after {
            content: "";
            position: absolute;
            inset: 0;
            background: url('/images/ui/adventurers_guild_banner.jpg') center/cover no-repeat;
            opacity: 0.18;
            mix-blend-mode: screen;
            pointer-events: none;
        }

        .banner-content {
            position: relative;
            display: flex;
            flex-wrap: wrap;
            gap: 18px 24px;
            align-items: center;
        }

        .banner-main {
            flex: 1 1 260px;
        }

        .banner-label {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(148, 163, 184, 0.5);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            margin-bottom: 10px;
            gap: 6px;
        }

        .banner-label-dot {
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: var(--accent);
            box-shadow: 0 0 10px rgba(251, 191, 36, 0.8);
        }

        .banner-title {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin: 0 0 6px;
        }

        .banner-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            max-width: 520px;
        }

        .banner-pill-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 14px;
        }

        .banner-pill {
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11px;
            border: 1px solid rgba(148, 163, 184, 0.5);
            background: rgba(15, 23, 42, 0.9);
            color: var(--text-muted);
            display: inline-flex;
            gap: 6px;
            align-items: center;
        }

        .banner-pill strong {
            color: var(--accent);
            font-weight: 600;
        }

        .banner-badge {
            flex: 0 0 auto;
            min-width: 180px;
            max-width: 220px;
            padding: 14px 16px;
            border-radius: 16px;
            background: radial-gradient(circle at 0 0, rgba(250, 250, 250, 0.08), transparent 60%),
                        rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.6);
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .banner-badge-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
        }

        .banner-badge-value {
            font-size: 18px;
            font-weight: 700;
            color: var(--accent);
        }

        .banner-badge-note {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* Layout sections */
        .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
    align-items: flex-start;
}


        @media (max-width: 960px) {
            .grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        .section {
            background: rgba(15, 23, 42, 0.92);
            border-radius: 16px;
            border: 1px solid var(--border-soft);
            padding: 14px 16px 10px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        .section + .section {
            margin-top: 16px;
        }

        .section-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

        .section-title {
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .section-title span {
            color: var(--accent);
        }

        .section-subtitle {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* Quests board */
        .quest-list {
            border-radius: 10px;
            border: 1px solid rgba(55, 65, 81, 0.9);
            overflow: hidden;
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.98));
        }

        .quest-row {
            display: grid;
            grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
            gap: 8px 14px;
            padding: 9px 11px;
            border-bottom: 1px solid rgba(31, 41, 55, 0.9);
        }

        .quest-row:nth-child(odd) {
            background: rgba(15, 23, 42, 0.9);
        }

        .quest-row:nth-child(even) {
            background: rgba(15, 23, 42, 0.98);
        }

        .quest-row:last-child {
            border-bottom: none;
        }

        @media (max-width: 720px) {
            .quest-row {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        .quest-main-title {
            font-size: 14px;
            font-weight: 600;
        }

        .quest-main-desc {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .quest-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 5px;
        }

        .quest-tag {
            font-size: 10px;
            padding: 2px 7px;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.55);
            color: var(--text-muted);
            background: rgba(15, 23, 42, 0.9);
        }

        .quest-tag.repeatable {
            border-color: var(--success);
            color: var(--success);
        }

        .quest-side {
            text-align: right;
            font-size: 11px;
            color: var(--text-muted);
        }

        @media (max-width: 720px) {
            .quest-side {
                text-align: left;
            }
        }

        .quest-reward {
            font-size: 12px;
            color: #e5e7eb;
        }
        .quest-cooldown-box {
            margin-top: 8px;
            padding: 8px 10px;
            border-radius: 10px;
            background: rgba(37, 99, 235, 0.12);
            border: 1px solid rgba(96, 165, 250, 0.6);
        }
        .quest-cooldown-label {
            font-size: 10px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #bfdbfe;
        }
        .quest-cooldown-timer {
            margin-top: 4px;
            font-size: 16px;
            font-weight: 700;
            color: #eff6ff;
            font-variant-numeric: tabular-nums;
        }
        .quest-status-note {
            margin-top: 8px;
            color: #cbd5e1;
        }
        .quest-refresh-pill {
            font-variant-numeric: tabular-nums;
        }
        .quest-refresh-inline {
            font-variant-numeric: tabular-nums;
            color: #f8fafc;
        }

        .quest-reward-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--text-muted);
        }

        /* Ranks list */
        .rank-list {
            margin-top: 6px;
            border-radius: 12px;
            border: 1px solid rgba(55, 65, 81, 0.9);
            overflow: hidden;
        }

        .rank-row {
            display: grid;
            grid-template-columns: 1.4fr 1.1fr;
            gap: 8px 12px;
            padding: 8px 11px;
            border-bottom: 1px solid rgba(31, 41, 55, 0.9);
            background: rgba(15, 23, 42, 0.96);
        }

        .rank-row:nth-child(odd) {
            background: rgba(15, 23, 42, 0.9);
        }

        .rank-row:last-child {
            border-bottom: none;
        }

        @media (max-width: 720px) {
            .rank-row {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        .rank-name {
            font-size: 13px;
            font-weight: 600;
        }

        .rank-exp-range {
            font-size: 11px;
            color: var(--text-muted);
        }

        .rank-desc {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* Leaderboard */
        .leaderboard-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(55, 65, 81, 0.9);
            background: rgba(15, 23, 42, 0.98);
        }

        .leaderboard-table thead {
            background: rgba(15, 23, 42, 0.98);
        }

        .leaderboard-table th,
        .leaderboard-table td {
            padding: 7px 9px;
            text-align: left;
            border-bottom: 1px solid rgba(31, 41, 55, 0.9);
        }

        .leaderboard-table th {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
        }

        .leaderboard-table tr:nth-child(even) td {
            background: rgba(15, 23, 42, 0.92);
        }

        .leaderboard-rank {
            width: 30px;
            font-weight: 600;
            color: var(--accent);
        }

        .leaderboard-name {
            font-weight: 500;
        }

        .leaderboard-tag-rank {
            font-size: 11px;
            padding: 2px 7px;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.5);
            color: var(--text-muted);
            background: rgba(15, 23, 42, 0.9);
        }

        .empty-message {
            font-size: 12px;
            color: var(--text-muted);
            padding: 8px 2px 4px;
        }

        .muted-inline {
            font-size: 11px;
            color: var(--text-muted);
        }
/* Panel + banner (same style as Legendary Forge) */
.panel {
    background: #1A1B25;
    border: 1px solid #232437;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0,0,0,.35);
    padding: 14px;
    margin: 12px 0 18px; /* a bit of bottom space before the text banner */
}

/* Image banner inside panel */
.panel--banner {
    padding: 0;
    overflow: hidden;
}

.banner-img {
    width: 100%;
    max-height: 260px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #232437;
