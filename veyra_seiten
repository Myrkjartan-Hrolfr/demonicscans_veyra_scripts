  });
})();


(function(){
    const bodyEl = document.body;
    const openBtn    = document.getElementById('openBattleDrawerBtn');
    const closeBtnn   = document.getElementById('closeBattleDrawerBtn');
    const backdrop   = document.getElementById('battleDrawerBackdrop');

    function openDrawerr(){
