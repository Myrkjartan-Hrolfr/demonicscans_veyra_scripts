/* nicer pulse: soft glow + tiny lift (no scale) */
@keyframes softGlow {
  0%   { box-shadow: 0 6px 18px rgba(0,0,0,.6), 0 0 0 rgba(255,211,105,0);
         filter: brightness(1);
         transform: translateY(0); }
  50%  { box-shadow: 0 10px 26px rgba(0,0,0,.72), 0 0 22px rgba(255,211,105,.22);
         filter: brightness(1.06);
         transform: translateY(-1px); }
  100% { box-shadow: 0 6px 18px rgba(0,0,0,.6), 0 0 0 rgba(255,211,105,0);
         filter: brightness(1);
         transform: translateY(0); }
}

/* subtle "ping" ring once in a while (optional but looks premium) */
@keyframes ringPing {
  0%   { opacity: 0; transform: scale(0.98); }
  15%  { opacity: .55; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.08); }
}

.pulse {
  position: relative;
  animation: softGlow 1.8s ease-in-out infinite;
}

.pulse::after{
  content:"";
  position:absolute;
  inset:-4px;
  border-radius: inherit;
  border: 1px solid rgba(255,211,105,.35);
  opacity: 0;
  pointer-events:none;
  animation: ringPing 3.2s ease-out infinite;
}

/* respect reduced motion */
@media (prefers-reduced-motion: reduce){
  .pulse, .pulse::after { animation: none; }
}
