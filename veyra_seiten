function openFxOverlay(options = {}){
  if (!fxOverlay) return;
  const auto = !!options.auto;
  const currentMode = (window.getCubeFxMode && window.getCubeFxMode()) || getStoredFxMode();
  const suggested = options.suggested || pendingFxSuggestion || "low";
  const reasons = Array.isArray(options.reasons) ? options.reasons : pendingFxReasons;
  if (fxModalTitle) fxModalTitle.textContent = auto ? "Low-Performance Device Detected" : "Visual Effects Settings";
  if (fxModalSub) fxModalSub.textContent = auto
    ? "This device looks like it may struggle with the full cube effects."
    : "Choose how much atmosphere your device should render.";
  if (fxModalDesc) {
    fxModalDesc.textContent = auto
      ? `The Crucible detected a weaker device profile${reasons.length ? ` because ${reasons.join(", ")}` : ""}. You can switch to Low FX for a lighter version, or turn effects Off completely.`
      : "High keeps the full fog, rune rings, and particle field. Low reduces those effects for better performance. Off disables the cube canvas effects entirely.";
  }
  if (fxCurrentMode) fxCurrentMode.textContent = `Current Mode: ${labelForFxMode(currentMode)}`;
  if (fxRecommendedMode) {
    fxRecommendedMode.style.display = auto ? "inline-flex" : "none";
    fxRecommendedMode.textContent = `Recommended: ${labelForFxMode(suggested)}`;
  }
  fxOverlay.classList.add("isOpen");
  fxOverlay.setAttribute("aria-hidden", "false");
  syncModalLock();
}

