async function lootWave(monsterId) {
  try {
    const userId = getUserId();
    if (!userId) {
      showNotification('Unable to get user ID. Please refresh the page.', 'error');
      return;
    }

    const formData = new FormData();
    formData.append('monster_id', monsterId);
    formData.append('user_id', userId);

    const response = await fetch('loot.php', {
      method: 'POST',
      body: formData
    });

    const data = JSON.parse(await response.text());
    if (data.status === 'success') {
      const lootContainer = document.getElementById('lootItems');
      lootContainer.innerHTML = '';

      data.items.forEach(item => {
        const qty = lootDisplayQty(item);
        const qtyText = new Intl.NumberFormat().format(qty);
        const div = document.createElement('div');
        div.style = 'background:#1e1e2f; border-radius:8px; padding:10px; text-align:center; width:96px;';
