            formData.append('user_id', userId);

            const response = await fetch('user_join_battle.php', {
              method: 'POST',
              body: formData
            });

            const msg = (await response.text()).trim();

            if (msg.includes("Invalid monster")) {
              showNotification("Monster is dead or invalid", "error");
              joinBtn.disabled = false;
              joinBtn.innerText = 'Join Battle';
              return;
            }

            const ok = msg.toLowerCase().startsWith('you have successfully');

            if (ok) {
              const tempLink = document.createElement('a');
              tempLink.href = battleLink.href;
              tempLink.target = '_blank';
              tempLink.style.display = 'none';
              document.body.appendChild(tempLink);
              tempLink.click();
              document.body.removeChild(tempLink);
              showNotification('Battle joined! Opening in new tab...', '#2ecc71');
            } else {
              showNotification(msg || 'Failed to join battle', '#e74c3c');
            }

            joinBtn.disabled = false;
            joinBtn.innerText = 'Join Battle';
          } catch (error) {
            showNotification('Server error. Please try again.', '#e74c3c');
            joinBtn.disabled = false;
            joinBtn.innerText = 'Join Battle';
          }
        } else {
          joinWaveInstant(monsterId, battleLink);
        }
      });

      const originalParent = battleLink.parentNode;
      originalParent.insertBefore(buttonContainer, battleLink);
      buttonContainer.appendChild(battleLink);
    }
  });
}

