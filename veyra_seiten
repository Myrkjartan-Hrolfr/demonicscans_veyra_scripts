<html><head>
  <title>User Dashboard</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    /* Prevent width overflow on mobile */
*, *::before, *::after { box-sizing: border-box; }
html, body { max-width: 100%; overflow-x: hidden; }

    body {
      font-family: Arial, sans-serif;
      background: #121212;
      color: #f1f1f1;
      margin: 0;
      padding: 0;
    }
    .container { margin: auto; padding: 20px; }
    h1 { text-align: center; margin-bottom: 20px; color: #fff; }
    .section { margin-bottom: 30px; }
    .header { font-size: 22px; font-weight: bold; margin-bottom: 10px; color: #ddd; text-align: center; }

    /* ===== Generic grid for small tiles ===== */
    .gates-flex {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }
    .gate-card {
      background: #1e1e1e;
      border-radius: 10px;
      overflow: hidden;
      text-align: center;
      transition: transform 0.2s;
      cursor: pointer;
      width: 250px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.4);
    }
    .gate-card:hover { transform: scale(1.03); }
    .gate-card img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      display: block;
    }
    .gate-card-name { padding: 12px; font-size: 16px; font-weight: bold; color: #f1f1f1; }
    a.gate-link { text-decoration: none; color: inherit; }

    @media (max-width: 600px) {
      .gate-card { width: 90%; margin: auto; }
    }

    .panel {
      background: #1A1B25;
      border: 1px solid #232437;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,.35);
      padding: 16px;
      margin: 20px auto;
    }

    /* How-to container */
       .howto-info{
      max-width: 900px;
      margin: 0 auto 24px;
      background:#1A1B25;
      border:1px solid #232437;
      border-radius:14px;
      box-shadow:0 8px 20px rgba(0,0,0,.35);
      overflow:hidden;
    }
    .howto-info-header{
      padding:10px 14px;
      border-bottom:1px solid #232437;
      background:#191a24;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }
    .howto-info-header h2{
      margin:0;
      font-size:20px;
      color:#FFD369;
    }

    .howto-toggle{
      background:#252638;
      border:1px solid #30324a;
      color:#e5e5e5;
      border-radius:999px;
      padding:5px 10px;
      font-size:12px;
      font-weight:600;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      gap:6px;
      text-transform:uppercase;
      letter-spacing:.04em;
    }
    .howto-toggle::before{
      content:'\25BE';
      font-size:11px;
      transition:transform .15s ease;
    }
    .howto-info.collapsed .howto-toggle::before{
      transform:rotate(-90deg);
    }

    .howto-info-scroll{ max-height:360px; overflow:auto; }
    .howto-info-body{ padding:16px; font-size:15px; line-height:1.7; color:#ddd; }
    .howto-info-body ul{ margin:8px 0 8px 20px; padding:0; list-style:disc; }
    .howto-info-scroll::-webkit-scrollbar{ width:10px; }
    .howto-info-scroll::-webkit-scrollbar-thumb{ background:#2b2d44; border-radius:10px; }
    .howto-info-scroll::-webkit-scrollbar-track{ background:#1A1B25; }

    /* When collapsed, hide content */
    .howto-info.collapsed .howto-info-scroll{
      display:none;
    }


    /* Event/PvP/BP/Gates cards (square) */
    .events-section { margin: 0 auto 28px; }
    .events-header {
      font-size: 22px;
      font-weight: 700;
      text-align: center;
      color: #FFD369;
      margin: 0 0 14px;
    }
    .events-grid{
      display:flex;
      flex-wrap:wrap;
      gap:20px;
      justify-content:center;
    }
    .event-card{
      position:relative;
      width:340px;
      background:#10131a;
      border:1px solid #232437;
      border-radius:16px;
      overflow:hidden;
      cursor:pointer;
      box-shadow:0 10px 24px rgba(0,0,0,.45);
      transition: transform .2s ease, box-shadow .2s ease;
      text-decoration:none;
      color:inherit;
    }
    .event-card:hover{
      transform: translateY(-4px);
      box-shadow:0 16px 32px rgba(0,0,0,.55);
    }
    .event-card.is-disabled{
      cursor: default;
    }
    .event-card.is-disabled:hover{
      transform: none;
    }
    .event-media{
      position:relative;
      width:100%;
      aspect-ratio: 1 / 1;
      background:#0e0f17;
    }
    .event-media img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }
    .event-overlay{
      position:absolute;
      inset:0;
      background: linear-gradient(to top, rgba(0,0,0,.55) 15%, rgba(0,0,0,0) 55%);
      pointer-events:none;
    }
    .event-body{ padding:14px 14px 16px; }
    .event-title{
      font-size:18px;
      font-weight:700;
      color:#f1f1f1;
      margin:0 0 10px;
      line-height:1.25;
      overflow:hidden;
      text-overflow:ellipsis;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
    }
    .event-cta{
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-size:14px;
      font-weight:700;
      padding:10px 14px;
      border-radius:10px;
      background:#2b2d44;
      color:#eaeaea;
      border:1px solid #393b58;
      text-decoration:none;
      transition: background .2s ease, transform .2s ease;
    }
    .event-cta:hover{ background:#33365a; transform: translateY(-1px); }
    .event-badge{
      position:absolute;
      top:10px; left:10px;
      background:#e24a4a;
      color:#fff;
      font-size:12px;
      font-weight:800;
      letter-spacing:.3px;
      padding:6px 10px;
      border-radius:999px;
      box-shadow:0 6px 16px rgba(0,0,0,.35);
      text-transform:uppercase;
    }

    /* Mobile sizing */
    @media (max-width: 600px){
      .event-card { width: 100%; max-width: 520px; }
    }

    /* Remove purple color + underline on visited links site-wide */
    a:link, a:visited { color: inherit; text-decoration: none; }
    a:hover, a:focus { text-decoration: none; }
    .event-card:visited .event-title,
    .gate-link:visited .gate-card-name,
    .event-cta:visited { color: inherit; }

    /* ===== Hero row (BP, PvP, Events, Gates) ===== */
    .hero-section { margin: 0 auto 28px; }
    .hero-header {
      font-size: 22px;
      font-weight: 700;
      text-align: center;
      color: #FFD369;
      margin: 0 0 14px;
    }

    .hero-card { text-decoration:none; }

    .active-players-today {
      max-width: 460px;
      margin: 0 auto 22px;
      padding: 14px 18px;
      border: 1px solid rgba(255, 211, 105, .32);
      border-radius: 18px;
      background:
        radial-gradient(circle at 12% 0%, rgba(255, 211, 105, .18), transparent 34%),
        linear-gradient(145deg, rgba(26, 27, 37, .98), rgba(14, 17, 28, .98));
      box-shadow: 0 14px 34px rgba(0,0,0,.38), inset 0 0 24px rgba(255, 211, 105, .06);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .active-players-today-label {
      color: #dfe7f2;
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .active-players-today-note {
      display: block;
      margin-top: 4px;
      color: #9aa7b8;
      font-size: 12px;
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0;
    }
    .active-players-today-count {
      color: #FFD369;
      font-size: 30px;
      line-height: 1;
      font-weight: 900;
      text-shadow: 0 0 16px rgba(255, 211, 105, .24);
      white-space: nowrap;
    }
    @media (max-width: 600px) {
      .active-players-today {
        align-items: flex-start;
        flex-direction: column;
      }
      .active-players-today-count {
        font-size: 34px;
      }
    }



/* ===== Hero row (BP, PvP, Events, Gates) ===== */
.hero-grid{
  display: flex;
  flex-wrap: wrap;
  gap: 20px;                 /* controls spacing between cards */
  justify-content: center;   /* center horizontally on big screens */
  align-items: stretch;
}

    /* Keep cards a tidy fixed width so they don't stretch into big gaps */
.hero-grid .event-card{
  width: 340px;              /* matches your design */
  max-width: 100%;
}

/* 2 per row on tablets/small desktops (flex will naturally wrap) */
@media (max-width: 900px){
  .hero-grid .event-card{ width: 48%; }  /* approx two per row */
}

/* 1 per row on mobiles */
@media (max-width: 600px){
  .hero-grid .event-card{ width: 100%; } /* single column */
}

/* ===== First anniversary preview ===== */
.anniversary-hero-card {
  border-color: rgba(255, 212, 112, .82);
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 205, 96, .16), transparent 44%),
    #10131a;
  box-shadow:
    0 0 0 1px rgba(255, 231, 164, .22),
    0 16px 38px rgba(0, 0, 0, .56),
    0 0 30px rgba(255, 179, 52, .18);
  animation: anniversary-card-glow 3.4s ease-in-out infinite;
}
.anniversary-hero-card .event-media {
  overflow: hidden;
}
.anniversary-hero-card .event-media::before {
  content: "";
  position: absolute;
  z-index: 3;
  top: -30%;
  bottom: -30%;
  left: -48%;
  width: 30%;
  pointer-events: none;
  transform: rotate(14deg);
  background: linear-gradient(90deg, transparent, rgba(255, 245, 202, .5), transparent);
  filter: blur(2px);
  animation: anniversary-shine 4.8s ease-in-out infinite;
}
.anniversary-hero-card .event-media::after {
  content: "";
  position: absolute;
  z-index: 2;
  inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(circle, rgba(255, 245, 197, .95) 0 1px, transparent 2px),
    radial-gradient(circle, rgba(255, 187, 63, .75) 0 1.5px, transparent 2.5px);
  background-position: 12% 24%, 78% 70%;
  background-size: 54px 54px, 83px 83px;
  mix-blend-mode: screen;
  opacity: .34;
  animation: anniversary-sparkles 3s ease-in-out infinite alternate;
}
.anniversary-hero-card .event-overlay {
  z-index: 3;
  background: linear-gradient(to top, rgba(10, 4, 0, .72) 5%, rgba(72, 35, 2, .08) 58%, transparent 78%);
}
.anniversary-hero-card .event-badge {
  z-index: 4;
  color: #2d1800;
  background: linear-gradient(135deg, #fff1ad, #f3b536 52%, #d47b10);
  border: 1px solid rgba(255, 248, 211, .85);
  box-shadow: 0 6px 18px rgba(0, 0, 0, .42), 0 0 18px rgba(255, 188, 48, .42);
}
.anniversary-hero-card .event-body {
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 205, 100, .14), transparent 60%),
    linear-gradient(180deg, #15131a, #0f1118);
}
.anniversary-hero-card .event-title {
  color: #ffe8a6;
  text-shadow: 0 0 14px rgba(255, 191, 55, .32);
}
.anniversary-countdown-label {
  color: #e8d8ae;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.event-start-countdown.anniversary-countdown {
  display: inline-flex !important;
  margin-top: 7px;
  padding: 8px 11px;
  border: 1px solid rgba(255, 215, 112, .44);
  border-radius: 10px;
  color: #fff4ce;
  background: rgba(76, 42, 5, .48);
  box-shadow: inset 0 0 14px rgba(255, 202, 78, .08);
  font-size: 15px;
  font-weight: 900;
  letter-spacing: .04em;
  font-variant-numeric: tabular-nums;
}
@keyframes anniversary-card-glow {
  0%, 100% { box-shadow: 0 0 0 1px rgba(255, 231, 164, .2), 0 16px 38px rgba(0, 0, 0, .56), 0 0 24px rgba(255, 179, 52, .14); }
  50% { box-shadow: 0 0 0 1px rgba(255, 240, 192, .38), 0 18px 42px rgba(0, 0, 0, .6), 0 0 38px rgba(255, 179, 52, .3); }
}
@keyframes anniversary-shine {
  0%, 24% { left: -48%; opacity: 0; }
  34% { opacity: .75; }
  60%, 100% { left: 125%; opacity: 0; }
}
@keyframes anniversary-sparkles {
  from { opacity: .2; transform: translateY(0); }
  to { opacity: .48; transform: translateY(-5px); }
}
@media (prefers-reduced-motion: reduce) {
  .anniversary-hero-card,
  .anniversary-hero-card .event-media::before,
  .anniversary-hero-card .event-media::after {
    animation: none;
  }
}


