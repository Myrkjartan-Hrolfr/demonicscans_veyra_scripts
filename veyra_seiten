    <style>
  /* Push page content below fixed bar */
  body { padding-top: 74px; }

  .game-topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 9999;
    background: rgba(18,18,18,0.95);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(255,255,255,0.06);

  }
  .gtb-inner{
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: #f1f1f1;
    font-family: Arial, sans-serif;
  }
  .gtb-left, .gtb-right{
    display: flex; align-items: center; gap: 12px;
  }
  .gtb-stat{
    display: inline-flex; align-items: center; gap: 5px;
    background: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    padding: 6px 7px;
    font-size: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  .gtb-icon{ opacity: 0.9 }
  .gtb-label{ color:#cfcfcf; margin-right: 4px }
  .gtb-value{ font-weight: 700 }

  .gtb-level{
    background:#262626; border:1px solid #2f2f2f;
    padding: 6px 10px; border-radius: 10px; font-weight: 700; font-size:14px;
  }
  .gtb-exp{ display:flex; flex-direction: column; gap: 6px; min-width: 240px }
  .gtb-exp-top{ display:flex; justify-content: space-between; font-size:12px; color:#cfcfcf }
  .gtb-exp-bar{
    height: 10px; border-radius: 999px; overflow: hidden;
    background: #2a2a2a; border: 1px solid #333;
    width: 100%;
  }
  .gtb-exp-fill{
    height: 100%;
    background: linear-gradient(90deg, #4caf50, #8bc34a);
    width: 0%;
    transition: width 0.3s ease;
  }

  /* Mobile */
  @media (max-width: 600px){
    body { padding-top: 100px; }
    .gtb-inner{ flex-direction: column; align-items: stretch; gap: 8px }
    .gtb-left{ justify-content: space-between; flex-wrap: wrap }
    .gtb-exp{ min-width: 100% }
  }
  /* --- Mobile EXP bar fix (place after existing CSS) --- */
.gtb-right { min-width: 0; }           /* allow shrinking */
.gtb-exp   { min-width: 0; flex: 1; }  /* let bar use available space */
.gtb-inner { box-sizing: border-box; } /* accurate width calc */

@media (max-width: 600px){
  .gtb-inner { gap: 8px; padding: 8px 10px; }
  .gtb-left  { width: 100%; justify-content: space-between; flex-wrap: wrap; }
  .gtb-right { width: 100%; gap: 8px; align-items: stretch; }
  .gtb-level { flex: 0 0 auto; }       /* size to content */
  .gtb-exp   { width: 100%; }          /* bar spans full width */
  .gtb-exp-top { font-size: 11px; }    /* tighter label on small screens */
}

/* optional: keep large numbers from stretching stat chips */
.gtb-stat .gtb-value { white-space: nowrap; }
.gtb-timer {
  margin-left: 6px;
  padding: 2px 6px;
  border-radius: 8px;
  background: #243b1f;
  border: 1px solid #2f5d28;
  font-size: 11px;
  color: #cfeccc;
  white-space: nowrap;
}
@media (max-width: 600px){
  .gtb-left { gap: 1px; }         /* tighter spacing */
  .gtb-stat {
    font-size: 11.5px;
    padding: 3px 3px;
  }

}

.gtb-value.mono { font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }
/* Mobile: add vertical space between wrapped rows and center the time chip */

@media (max-width: 600px){
  .gtb-left{
    /* vertical space between wrapped rows */
    row-gap: 10px;
    /* keep horizontal spacing tidy (override any previous gap) */
    column-gap: 6px;
  }

  .gtb-stat.time-chip{
    flex: 0 0 auto !important; /* don't stretch / no 100% width */
    width: auto !important;
    /* optional: small left/right auto-margins won't force full width */
    margin-left: 0;
    margin-right: 0;
  }
}
