/* Sub Classes section (necromancer themed clickable card) */
.section-subclasses {
    margin-top: 14px;
    background:
        radial-gradient(circle at top right, rgba(168, 85, 247, 0.24), transparent 34%),
        radial-gradient(circle at bottom left, rgba(76, 29, 149, 0.32), transparent 42%),
        linear-gradient(135deg, #120f1f 0%, #1b1430 42%, #24163f 100%);
    border-radius: 16px;
    border: 1px solid rgba(168, 85, 247, 0.45);
    padding: 14px 16px 12px;
    box-shadow:
        0 14px 30px rgba(0, 0, 0, 0.48),
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        inset 0 0 26px rgba(168, 85, 247, 0.08);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.12s ease-out, box-shadow 0.12s ease-out, border-color 0.12s ease-out, filter 0.12s ease-out;
}

.section-subclasses::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(120deg, transparent 0%, rgba(196, 181, 253, 0.08) 38%, transparent 62%);
    transform: translateX(-100%);
    transition: transform 0.45s ease;
    pointer-events: none;
}

.section-subclasses:hover {
    transform: translateY(-1px);
    border-color: rgba(192, 132, 252, 0.9);
    box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.62),
        0 0 26px rgba(168, 85, 247, 0.18),
        inset 0 1px 0 rgba(255, 255, 255, 0.05),
        inset 0 0 30px rgba(168, 85, 247, 0.12);
    filter: saturate(1.06);
}

.section-subclasses:hover::before {
    transform: translateX(100%);
}

.section-subclasses .section-header {
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
}

.section-subclasses .section-title {
    color: #c4b5fd;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 0 12px rgba(168, 85, 247, 0.16);
}

.section-subclasses .section-title span {
    color: #a855f7;
}

.section-subclasses .section-subtitle {
    color: #d8ccf7;
}

.section-subclasses-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid rgba(192, 132, 252, 0.45);
    font-size: 11px;
    color: #efe7ff;
    background: linear-gradient(135deg, rgba(91, 33, 182, 0.42), rgba(31, 15, 54, 0.72));
    box-shadow: inset 0 0 14px rgba(168, 85, 247, 0.12);
    position: relative;
    z-index: 1;
}

.section-subclasses-pill span.icon {
    font-size: 14px;
    color: #c084fc;
}

