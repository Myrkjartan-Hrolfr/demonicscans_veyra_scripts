/* === Batch Loot Control Panel === */
.batch-loot-card {
  max-width: 900px;
  margin: 0 auto 18px;

  background:#1A1B25;
  border:1px solid #232437;
  border-radius:14px;
  box-shadow:0 8px 20px rgba(0,0,0,.6);

  padding:16px;
  color:#e6e9ff;
  display:flex;
  flex-direction:column;
  gap:16px;
  font-size:13px;
  line-height:1.4;
}

/* top row: visibility + unclaimed */
.bl-row-top {
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  align-items:center;
  justify-content:space-between;
}

/* left side of top row */
.bl-left {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:12px;
}

/* hide/show button */
#toggleDeadBtn {
  background:#333;
  border:none;
  border-radius:8px;
  padding:8px 12px;
  font-size:13px;
  color:#fff;
  line-height:1.2;
  cursor:pointer;
  box-shadow:0 6px 18px rgba(0,0,0,.6);
  border:1px solid #2b2d44;
}
#toggleDeadBtn:hover {
  background:#444;
}
#toggleDeadBossBtn {
  background:#4b2f19;
  border:none;
  border-radius:8px;
  padding:8px 12px;
  font-size:13px;
  color:#ffe2b2;
  line-height:1.2;
  cursor:pointer;
  box-shadow:0 6px 18px rgba(0,0,0,.6);
  border:1px solid rgba(255,176,117,.22);
}
#toggleDeadBossBtn:hover {
  background:#5d381c;
}
#toggleDeadBossBtn.active {
  background:linear-gradient(180deg, #8b4a12, #6a320a);
  border-color:#ffca7a;
  color:#fff4d8;
}

/* unclaimed pill */
.unclaimed-pill {
  background:#222436;
  border:1px solid #2b2d44;
  border-radius:8px;
  padding:8px 10px;
  line-height:1.3;
  font-size:13px;
  box-shadow:0 6px 18px rgba(0,0,0,.6);
  color:#e6e9ff;
  display:flex;
  align-items:center;
  gap:6px;
  font-weight:500;
}
.unclaimed-pill .count {
  color:#FFD369;
  font-weight:700;
  text-shadow:0 0 6px rgba(255,211,105,.6);
}

/* bottom row: loot form */
.bl-row-bottom {
  background:#191a24;
  border:1px solid #2b2d44;
  border-radius:10px;
  padding:12px 14px;
  box-shadow:0 6px 18px rgba(0,0,0,.8);

  display:flex;
  flex-direction:column;
  gap:12px;
}

/* form line with label + input + button */
.bl-lootline {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:center;
  justify-content:flex-start;
}

/* the "Loot up to [X]" chunk */
.bl-loot-chunk {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:6px;
  color:#e6e9ff;
  font-size:13px;
  line-height:1.3;
}

/* number input */
.bl-loot-chunk input[type="number"] {
  width:70px;
  padding:6px 8px;
  border-radius:6px;
  border:1px solid #2b2d44;
  background:#1e1e2e;
  color:#e6e9ff;
  font-size:13px;
  line-height:1.3;
  text-align:center;
  box-shadow:0 4px 12px rgba(0,0,0,.6);
}

/* loot button */
#btnLootX {
  background:#333;
  border:none;
  border-radius:8px;
  padding:8px 12px;
  font-size:13px;
  line-height:1.2;
  color:#fff;
  cursor:pointer;
  box-shadow:0 6px 18px rgba(0,0,0,.6);
  border:1px solid #2b2d44;
  white-space:nowrap;
}
#btnLootX:hover {
  background:#444;
}
#btnLootX.is-running {
  opacity:.6;
  pointer-events:none;
}

/* status line */
#lootStatus {
  color:#9aa0be;
  font-size:12px;
  min-height:16px;
  line-height:1.4;
  word-break:break-word;
}

/* responsive tweaks */
@media (min-width:600px){
  .bl-row-bottom {
    flex-direction:row;
    align-items:flex-start;
    justify-content:space-between;
  }

  .bl-lootline {
