/* nicer pulse: soft glow + tiny lift (no scale) */
@keyframes softGlow {
  0%   { box-shadow: 0 6px 18px rgba(0,0,0,.6), 0 0 0 rgba(255,211,105,0);
         filter: brightness(1);
         transform: translateY(0); }
  50%  { box-shadow: 0 10px 26px rgba(0,0,0,.72), 0 0 22px rgba(255,211,105,.22);
         filter: brightness(1.06);
         transform: translateY(-1px); }
  100% { box-shadow: 0 6px 18px rgba(0,0,0,.6), 0 0 0 rgba(255,211,105,0);
         filter: brightness(1);
         transform: translateY(0); }
}

/* subtle "ping" ring once in a while (optional but looks premium) */
@keyframes ringPing {
  0%   { opacity: 0; transform: scale(0.98); }
  15%  { opacity: .55; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.08); }
}

.pulse {
  position: relative;
  animation: softGlow 1.8s ease-in-out infinite;
}

.pulse::after{
  content:"";
  position:absolute;
  inset:-4px;
  border-radius: inherit;
  border: 1px solid rgba(255,211,105,.35);
  opacity: 0;
  pointer-events:none;
  animation: ringPing 3.2s ease-out infinite;
}

/* respect reduced motion */
@media (prefers-reduced-motion: reduce){
  .pulse, .pulse::after { animation: none; }
}
/* --- Selection checkbox (modern overlay, top-left) --- */
.monster-card{ position:relative; } /* required for absolute overlay */
.stack-badge{
  position:absolute;
  top:10px;
  right:10px;
  z-index:6;
  padding:7px 11px;
  border-radius:999px;
  background:linear-gradient(135deg, rgba(255,213,94,.96), rgba(255,143,43,.94));
  border:1px solid rgba(255,255,255,.38);
  color:#1b1204;
  font-weight:900;
  font-size:12px;
  letter-spacing:.03em;
  box-shadow:0 8px 20px rgba(255,170,40,.28), inset 0 1px 0 rgba(255,255,255,.55);
  text-transform:uppercase;
}

.pickWrap{
  position:absolute;
  top:10px;
  left:10px;
  z-index:5;

  display:inline-flex;
  align-items:center;
  gap:8px;

  padding:6px 10px;
  border-radius:999px;

  background: rgba(10,11,18,.65);
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 10px 22px rgba(0,0,0,.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  font-size:12px;
  color:#e6e9ff;
  cursor:pointer;
  user-select:none;
}

.pickWrap input[type="checkbox"]{
  appearance:none;
  -webkit-appearance:none;
  width:18px;
  height:18px;
  border-radius:6px;
  border:1px solid rgba(140,160,255,.35);
  background: rgba(30,33,50,.85);
  display:grid;
  place-items:center;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 6px 14px rgba(0,0,0,.55);
  cursor:pointer;
}

.pickWrap input[type="checkbox"]::after{
  content:"";
  width:10px;
  height:6px;
  border-left:2px solid #0c1;
  border-bottom:2px solid #0c1;
  transform: rotate(-45deg) scale(0);
  transform-origin:center;
  transition: transform .12s ease;
  filter: drop-shadow(0 0 6px rgba(0,255,120,.45));
}

.pickWrap input[type="checkbox"]:checked{
  border-color: rgba(0,255,140,.55);
  background: rgba(0,255,140,.12);
}

.pickWrap input[type="checkbox"]:checked::after{
  transform: rotate(-45deg) scale(1);
}

.pickWrap:hover{
  border-color: rgba(140,160,255,.22);
  background: rgba(10,11,18,.72);
}
