async function joinWaveInstant(monsterId, originalLink) {
  showNotification('Joining battle...', '#2ecc71');

  try {
    const userId = getUserId();
    if (!userId) {
      showNotification('Unable to get user ID. Please refresh the page.', 'error');
      return;
    }

    const formData = new FormData();
    formData.append('monster_id', monsterId);
    formData.append('user_id', userId);

    const response = await fetch('user_join_battle.php', {
      method: 'POST',
      body: formData
    });

    const msg = (await response.text()).trim();

    if (msg.includes("Invalid monster")) {
      showNotification("Monster is dead or invalid", "error");
      return;
    }

    const ok = msg.toLowerCase().startsWith('you have successfully');
    showNotification(msg || 'Unknown response', ok ? '#2ecc71' : '#e74c3c');

    if (ok) {
      setTimeout(() => {
        window.location.href = originalLink.href;
      }, 1000);
    }
  } catch (error) {
    showNotification('Server error. Please try again.', '#e74c3c');
  }
