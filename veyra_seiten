}
.gate-desc{ color:#E8E3D7 !important; }

/* Scrollbar: gold on ink */
.gate-info-scroll::-webkit-scrollbar{ width:10px; }
.gate-info-scroll::-webkit-scrollbar-thumb{
  background: linear-gradient(180deg, var(--lizard-gold-3), var(--lizard-gold));
  border-radius:10px;
}
.gate-info-scroll::-webkit-scrollbar-track{ background:#191a1f; }

/* ==== MONSTER CARD ==== */
.monster-card{
