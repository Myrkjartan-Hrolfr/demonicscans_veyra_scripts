}

/* ==== NAV CHIPS ==== */
.waves-nav .wave-chip{
  background: linear-gradient(180deg, #1c1e24, #15171c);
  border:1px solid rgba(219,186,107,.18) !important;
  color:#e9e3d3;
  box-shadow: 0 6px 18px rgba(0,0,0,.45);
}
.waves-nav .wave-chip:hover{
  background:#1b1d22;
  border-color: var(--lizard-gold-3) !important;
}
.waves-nav .wave-chip.active{
  background: linear-gradient(180deg, #222429, #17191d) !important;
  border-color: var(--lizard-gold) !important;
  box-shadow: 0 0 0 2px rgba(219,186,107,.20) inset, 0 12px 28px rgba(0,0,0,.55);
  color:#fff;
}

/* ==== INFO / GENERIC CARDS ==== */
.gate-info,
.batch-loot-card,
.wave-title,
.thresholds-card{
  background: linear-gradient(180deg, rgba(20,21,25,.92), rgba(15,16,20,.92)) !important;
  border:1px solid rgba(219,186,107,.22) !important;
  box-shadow:
    0 12px 28px rgba(0,0,0,.6),
