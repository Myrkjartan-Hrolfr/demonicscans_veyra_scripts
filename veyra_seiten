    };
    setCookie(WAVE_FILTER_KEY, JSON.stringify(payload), 30);
  }

  function loadWaveFilters(){
    const raw = getCookie(WAVE_FILTER_KEY);
    if (!raw) return null;
    try { return JSON.parse(raw); } catch(_e){ return null; }
  }

  function buildMonsterNameOptions(){
    if (!nameSel) return;

    // Collect unique names from ALIVE monster cards (QOL ignores dead anyway)
    const seen = new Map(); // lower -> display
    document.querySelectorAll('.monster-card[data-dead="0"]').forEach(card => {
      const lower = (card.dataset.name || '').trim(); // you already store lowercase in data-name
      if (!lower) return;
      // Use the visible title as display text (keeps case/spaces)
      const h3 = card.querySelector('h3');
      const display = (h3 && h3.textContent) ? h3.textContent.trim() : lower;
      if (!seen.has(lower)) seen.set(lower, display);
    });

    // Preserve current selection
    const current = nameSel.value || '';

    // Reset options (keep "All monsters")
    nameSel.innerHTML = `<option value="">All monsters</option>`;

    // Sort by display text
    const arr = Array.from(seen.entries()).sort((a,b) => a[1].localeCompare(b[1]));
    for (const [lower, display] of arr){
      const opt = document.createElement('option');
      opt.value = lower;          // match card.dataset.name (lowercase)
      opt.textContent = display;  // pretty label
      nameSel.appendChild(opt);
    }

    // Restore selection if still exists
    if (current && seen.has(current)) nameSel.value = current;
  }

  function initContinueBattleFirst(){
    const monsterContainer = document.querySelector('.monster-container');
    if (!monsterContainer) return;

    const continueCards = Array.from(monsterContainer.querySelectorAll('.monster-card'))
      .filter(card => !!card.querySelector('.continue-btn'));

    continueCards.reverse().forEach(card => {
      monsterContainer.prepend(card);
    });
  }

  function applyFilters(){
    const selected = (nameSel?.value || '').trim(); // lowercase or ''
    const wantJoined = !!fJoined?.checked;
    const wantUnjoined = !!fUnjoined?.checked;
    const wantCapNotReached = !!fCapNotReached?.checked;

    document.querySelectorAll('.monster-card').forEach(card => {
      // ignore dead cards (your QOL is for active monsters)
      if (card.dataset.dead === '1') return;

      const nmLower = (card.dataset.name || '').trim(); // already lowercase
      const isJoined = card.dataset.joined === '1';

      const okName = !selected || nmLower === selected; // exact match by dropdown
      const okJoin = (isJoined && wantJoined) || (!isJoined && wantUnjoined);
      const okCap  = !wantCapNotReached || card.dataset.capnotreached === '1';

      card.style.display = (okName && okJoin && okCap) ? '' : 'none';
    });

    saveWaveFilters();
  }

  // Restore filters on load (auto-check on refresh)
  (function initWaveFilters(){
    buildMonsterNameOptions();

    const saved = loadWaveFilters();
    if (saved){
      if (nameSel && typeof saved.name === 'string') nameSel.value = saved.name;
      if (typeof saved.joined === 'boolean')   fJoined.checked = saved.joined;
      if (typeof saved.unjoined === 'boolean') fUnjoined.checked = saved.unjoined;
      if (typeof saved.cap === 'boolean')      fCapNotReached.checked = saved.cap;
    }

    applyFilters();
  })();

  // Hook listeners
  [nameSel, fJoined, fUnjoined, fCapNotReached].forEach(el => {
    if (!el) return;
    el.addEventListener('change', applyFilters);
    el.addEventListener('input', applyFilters);
  });
    // ---------- SELECTION LIMIT ----------
  const MAX_QUICK_TARGETS = 10;

  function selectedCount(){
    return document.querySelectorAll('.pickMonster:checked').length;
  }

  function updateSelectionUi(){
    const c = selectedCount();
    // Optional: show count in status line
    showStatus(`Selected: <b>${c}/${MAX_QUICK_TARGETS}</b>`);
  }

  // Enforce max 10 when user clicks a checkbox
  document.addEventListener('change', (e) => {
    const cb = e.target;
    if (!cb || !cb.classList || !cb.classList.contains('pickMonster')) return;

    if (cb.checked && selectedCount() > MAX_QUICK_TARGETS) {
      cb.checked = false;
      showStatus(`⚠️ You can select up to <b>${MAX_QUICK_TARGETS}</b> monsters for Quick Attack.`);
      return;
    }
    updateSelectionUi();
  });

  // ---------- SELECTION ----------
  const btnSel = document.getElementById('btnSelectVisible');
  const btnClr = document.getElementById('btnClearSelect');

   btnSel?.addEventListener('click', () => {
    const remaining = Math.max(0, MAX_QUICK_TARGETS - selectedCount());
    if (remaining <= 0) {
      showStatus(`⚠️ Already selected <b>${MAX_QUICK_TARGETS}</b> monsters (max).`);
      return;
    }

    let picked = 0;
    document.querySelectorAll('.monster-card').forEach(card => {
      if (picked >= remaining) return;
      if (card.dataset.dead === '1') return;
      if (card.style.display === 'none') return;

      const cb = card.querySelector('.pickMonster');
      if (cb && !cb.checked) {
        cb.checked = true;
        picked++;
      }
    });

    updateSelectionUi();
  });


  btnClr?.addEventListener('click', () => {
    document.querySelectorAll('.pickMonster').forEach(cb => cb.checked = false);
    updateSelectionUi();
  });


  function getSelectedMonsterIds(){
    return Array.from(document.querySelectorAll('.pickMonster:checked'))
      .map(cb => parseInt(cb.dataset.mid || '0', 10))
      .filter(Boolean)
      .slice(0, MAX_QUICK_TARGETS);
  }




async function doJoin(monsterId){
  if (!JOIN_URL) return { ok:false, msg:'Join endpoint not set' };
  if (!USER_ID)  return { ok:false, msg:'Missing USER_ID' };

  // ✅ user_join_battle.php expects POST monster_id + user_id
  const r = await postForm(JOIN_URL, {
    monster_id: monsterId,
    user_id: USER_ID
  });

  const n = normalizeOk(r);
  return { ok: n.ok, msg: n.msg, data: n.data, raw: n.raw };
}




async function doAttack(monsterId, skillId, stam){
  if (!ATTACK_URL) return { ok:false, msg:'Attack endpoint not set' };

  // ✅ damage.php expects POST monster_id + skill_id
  const payload = {
    monster_id: monsterId,
    skill_id: skillId,
    stamina_cost: stam

  };

  const r = await postForm(ATTACK_URL, payload, true);
  const n = normalizeOk(r);
    const msg = n.msg || (n.ok ? `Attacked (${stam})` : `Attack failed (${stam})`);
  return { ok: n.ok, msg: n.msg, data: n.data, raw: n.raw };
}




  function openBatchAttackModal(results){
    const ok = results.filter(r => r.attackOk).length;
    const fail = results.length - ok;

    const sum = document.getElementById('bamSummary');
    const list = document.getElementById('bamList');

    if (sum) sum.textContent = `Processed: ${results.length} | Success: ${ok} | Failed: ${fail}`;
    if (list){
      list.innerHTML = results.map(r => {
        const color = r.attackOk ? '#7CFFB8' : '#ff6b6b';
        const border = r.attackOk ? 'rgba(0,255,140,.25)' : 'rgba(255,0,80,.25)';
        return `
          <div style="background:#1e1e2f;border:1px solid ${border};border-radius:10px;padding:10px 12px;">
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;">
              <div style="font-weight:700;color:#e6e9ff;">
                #${r.monsterId}
              </div>
              <div style="font-weight:800;color:${color};">
                ${r.attackOk ? '✅ OK' : '❌ FAIL'}
              </div>
            </div>
            <div style="margin-top:6px;color:#9aa0be;font-size:12px;line-height:1.45;">
              ${r.joinMsg ? `Join: ${escapeHtml(r.joinMsg)}<br>` : ''}
              Attack: ${escapeHtml(r.attackMsg || '')}
            </div>
          </div>
        `;
      }).join('');
    }

    document.getElementById('batchAttackModal').style.display = 'flex';
  }

  function escapeHtml(s){
    return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }



  // ---------- QUICK JOIN & ATTACK (MULTI BUTTONS) ----------
const quickBtns = Array.from(document.querySelectorAll('.btnQuickJoinAttack'));

function setQuickBtnsRunning(running){
  quickBtns.forEach(b => {
    b.disabled = running;
    b.style.opacity = running ? '0.7' : '';
  });
}

quickBtns.forEach(btn => {
  btn.addEventListener('click', async () => {
    const ids = getSelectedMonsterIds();
    if (!ids.length) { showStatus('Select at least 1 monster.'); return; }

    const skillId = parseInt(btn.dataset.skillId || '0', 10);
    const stam    = parseInt(btn.dataset.stam || '1', 10);

    // don’t run if endpoints not set
    if (!JOIN_URL || !ATTACK_URL){
      showStatus('Quick Join/Attack endpoints are not configured in the script.');
      openBatchAttackModal(ids.map(id => ({
        monsterId:id,
        joinMsg:'',
        attackOk:false,
        attackMsg:`Endpoints not set (wanted ${stam} stamina)`
      })));
      return;
    }

    setQuickBtnsRunning(true);
    showStatus(`Processing ${ids.length} monsters with ${stam} stamina...`);

    const results = [];

    for (let i=0;i<ids.length;i++){
      const id = ids[i];
      showStatus(`(${i+1}/${ids.length}) Joining/Attacking monster #${id} (${stam} stamina)...`);

      const card = document.querySelector(`.monster-card[data-monster-id="${id}"]`);
      const alreadyJoined = card && card.dataset.joined === '1';

      let joinRes = { ok:true, msg:'' };
      if (!alreadyJoined){
        try { joinRes = await doJoin(id); }
        catch(e){ joinRes = { ok:false, msg:'Join request failed' }; }
      }

      if (!joinRes.ok){
        results.push({
          monsterId:id,
          joinMsg:joinRes.msg,
          attackOk:false,
          attackMsg:`Skipped (join failed)`,
        });
        continue;
      }

      if (card){
        card.dataset.joined = '1';
        card.dataset.unjoined = '0';
      }

      // Send BOTH values so your backend can use whichever it expects.
      // (If your attack endpoint only needs skill_id, it will ignore stamina_cost.)
      let atkRes;
      try {
        atkRes = await doAttack(id, skillId, stam);
        console.log('ATTACK RAW:', atkRes.raw);
        if (!atkRes.msg) atkRes.msg = atkRes.ok ? `Attacked (${stam})` : `Attack failed (${stam})`;
      } catch(e){
        atkRes = { ok:false, msg:`Attack request failed (${stam})` };
      }


      results.push({
        monsterId:id,
        joinMsg: joinRes.msg,
        attackOk: !!atkRes.ok,
        attackMsg: atkRes.msg
      });

      await new Promise(r => setTimeout(r, 1100));
    }

    showStatus('Done.');
    setQuickBtnsRunning(false);
    openBatchAttackModal(results);
  });
});


  // initial
  initContinueBattleFirst();
  applyFilters();
})();
</script>
<script>
(function(){
  const serverNow = 1793208022; // server epoch seconds at render time
  const clientAtLoad = Math.floor(Date.now() / 1000);
  const offset = serverNow - clientAtLoad; // constant offset

  function fmt(sec){
    sec = Math.max(0, Math.floor(sec));
    const s = sec % 60;
    const m = Math.floor(sec / 60) % 60;
    const h = Math.floor(sec / 3600);
    if (h > 0) return `${h}h ${m}m ${s}s`;
    if (m > 0) return `${m}m ${s}s`;
    return `${s}s`;
  }

  function tickAutoSummon(){
    const now = Math.floor(Date.now() / 1000) + offset; // ticks, but server-aligned

    document.querySelectorAll('.auto-summon-card').forEach(card => {
      const nextTs = parseInt(card.getAttribute('data-next-ts') || '0', 10);
      const el = card.querySelector('.auto-summon-timer');
      if (!el || !nextTs) return;

      const left = nextTs - now;
      el.textContent = (left <= 0) ? 'any moment' : fmt(left);
    });
  }

  tickAutoSummon();
  setInterval(tickAutoSummon, 1000);
})();
</script>

