<script>

(function(){
  const COOKIE_NAME = "af_panel_collapsed";

  function setCookie(name, value, days){
    const d = new Date();
    d.setTime(d.getTime() + (days*24*60*60*1000));
    document.cookie = name + "=" + encodeURIComponent(value) + "; expires=" + d.toUTCString() + "; path=/; SameSite=Lax";
  }
  function getCookie(name){
    const match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([$?*|{}\(\)\[\]\\\/\+^])/g,'\\$1') + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function clampPct(p){ return Math.max(0, Math.min(100, p)); }
  function pct(used, max){
    if (!max || max <= 0) return 0;
    return clampPct((used / max) * 100);
  }

  function setMiniBar(fillId, textId, used, max, infiniteOk=false){
    const fill = document.getElementById(fillId);
    const text = document.getElementById(textId);

    const p = (max > 0) ? pct(used, max) : (infiniteOk && used > 0 ? 100 : 0);

    if (fill) fill.style.width = p.toFixed(2) + "%";
    if (text) {
      if (max > 0) text.textContent = used.toLocaleString() + " / " + max.toLocaleString();
      else if (infiniteOk) text.textContent = used.toLocaleString() + " / ∞";
      else text.textContent = used.toLocaleString() + " / 0";
    }
  }

  function setText(id, val){
    const el = document.getElementById(id);
    if (el) el.textContent = Number(val || 0).toLocaleString();
  }

  function updateBadge(enabled, finished){
    const badge = document.getElementById("afStateBadge");
    if (!badge) return;

    badge.classList.remove("on","off","fin");

    if (finished){
      badge.classList.add("fin");
      badge.textContent = "FINISHED";
    } else if (enabled){
      badge.classList.add("on");
      badge.textContent = "RUNNING";
    } else {
      badge.classList.add("off");
      badge.textContent = "PAUSED";
    }
  }

  function applyAutoFarm(settings){
    const enabled  = Number(settings.IS_ENABLED || 0) === 1;
    const finished = Number(settings.FINISHED || 0) === 1;

    updateBadge(enabled, finished);

    // update the small numbers in the big panel
    setText("afTotalKilledText", settings.TOTAL_MONSTERS_TO_KILLED);
    setText("afHpUsedText", settings.HP_POTIONS_USED);
    setText("afSt20UsedText", settings.STAM_POT_SMALL_ITEM_MAX_USED);
    setText("afStHalfUsedText", settings.STAM_POT_HALF_ITEM_ID_MAX_USED);
    setText("afStFullUsedText", settings.STAM_POT_FULL_ITEM_ID_MAX_USED);
    setText("afStAdvUsedText", settings.STAM_POT_ADV_ITEM_MAX_USED);

    // mini bars
    const totalKill = Number(settings.TOTAL_MONSTERS_TO_KILL || 0);
    const killed    = Number(settings.TOTAL_MONSTERS_TO_KILLED || 0);
    setMiniBar("afMiniKillsFill","afMiniKillsText", killed, totalKill, true);

    setMiniBar("afMiniHpFill","afMiniHpText",
      Number(settings.HP_POTIONS_USED||0),
      Number(settings.HP_POTIONS_MAX_TO_USE||0)
    );

    setMiniBar("afMiniS20Fill","afMiniS20Text",
      Number(settings.STAM_POT_SMALL_ITEM_MAX_USED||0),
      Number(settings.STAM_POT_SMALL_ITEM_MAX_TO_USE||0)
    );

    setMiniBar("afMiniSHFill","afMiniSHText",
      Number(settings.STAM_POT_HALF_ITEM_ID_MAX_USED||0),
      Number(settings.STAM_POT_HALF_ITEM_ID_MAX_TO_USE||0)
    );

    setMiniBar("afMiniSFFill","afMiniSFText",
      Number(settings.STAM_POT_FULL_ITEM_ID_MAX_USED||0),
      Number(settings.STAM_POT_FULL_ITEM_ID_MAX_TO_USE||0)
    );

    setMiniBar("afMiniSAdvFill","afMiniSAdvText",
      Number(settings.STAM_POT_ADV_ITEM_MAX_USED||0),
      Number(settings.STAM_POT_ADV_ITEM_MAX_TO_USE||0)
    );
  }

  async function fetchAutoFarmStatus(){
    try{
      const r = await fetch("auto_farm_status.php?_=" + Date.now(), { cache:"no-store" });
      if (!r.ok) return;
      const j = await r.json();
      if (!j || !j.ok || !j.settings) return;
      applyAutoFarm(j.settings);
    }catch(e){}
  }

  document.addEventListener("DOMContentLoaded", () => {
    const panel = document.getElementById("autoFarmPanel");
    const btn   = document.getElementById("afToggleBtn");

    // cookie restore
    const collapsed = getCookie(COOKIE_NAME) === "1";
    if (panel && collapsed) {
      panel.classList.add("af-collapsed");
      if (btn) btn.textContent = "👁️ Show";
    }

    // toggle
    if (panel && btn) {
      btn.addEventListener("click", () => {
        const nowCollapsed = panel.classList.toggle("af-collapsed");
        setCookie(COOKIE_NAME, nowCollapsed ? "1" : "0", 365);
        btn.textContent = nowCollapsed ? "👁️ Show" : "🙈 Hide";
      });
    }

    // initial + every 5s
    fetchAutoFarmStatus();
    setInterval(fetchAutoFarmStatus, 20000);
  });
})();
async function instantLoot() {
  if (!document.getElementById('lootModal')) {
    var modal = document.createElement('div');
    modal.innerHTML = `<div id="lootModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; align-items:center; justify-content:center;">
      <div style="background:#2a2a3d; border-radius:12px; padding:15px; max-width:80%; width:300px; text-align:center; color:white; overflow-y:auto; max-height:70%;">
