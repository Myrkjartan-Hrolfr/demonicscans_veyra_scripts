    /* outer frame keeps the border; overlay is sized exactly to the image */
.mapframe{
  border:1px solid var(--border);
  border-radius:14px;
  overflow:hidden;
  background:#0b0e17;
}

.mapwrap{
  position:relative;
  line-height:0;        /* remove gaps around inline img */
}

.mapwrap img.map{
  display:block;
  width:100%;
  height:auto;          /* preserves aspect ratio */
}

/* absolute overlay tracks the rendered image size exactly */
.mapwrap .overlay{
  position:absolute;
  left:0; top:0; width:100%; height:100%;
  pointer-events:none;  /* pins will enable their own clicks */
}

/* center-on-click coordinates (same as admin) */
.pin{
  position:absolute;
  transform:translate(-50%,-50%);  /* center the pin on the stored point */
  width:180px; height:180px; border-radius:50%;
  border:1px solid var(--border);
  background:#121522; display:flex; align-items:center; justify-content:center;
  box-shadow:0 6px 16px rgba(0,0,0,.45);
  pointer-events:auto;
}
